#!/bin/bash

set -euo pipefail



# Re-enter the pre-refresh provisioning state. Only a completed
# provisioning run leaves the marker that tailscale-up.service touches
# after "tailscale up" succeeds; tailscaled creates its state directory
# before that, so the marker alone distinguishes a provisioned node from
# an interrupted attempt. Without it, fall through and let check-health
# start the authentication service from the beginning.
state="$SDK_STATE_DIR/tailscale"
if [ -f "$state/provisioned" ]; then
  install -d --mode=700 /var/lib/tailscale
  cp -a "$state/." /var/lib/tailscale/
  # Enable afresh: the rebuilt container's systemd has no record of
  # the enablement tailscale-up.service performed at provisioning.
  systemctl enable tailscaled.service
  systemctl start tailscaled.service
fi
