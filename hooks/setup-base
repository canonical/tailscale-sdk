#!/bin/bash

set -euo pipefail

install -D --mode=644 \
  "$SDK/tailscaled.service" \
  /etc/systemd/system/tailscaled.service
install -D --mode=644 \
  "$SDK/tailscale-up.path" \
  /etc/systemd/system/tailscale-up.path
install -D --mode=644 \
  "$SDK/tailscale-up.service" \
  /etc/systemd/system/tailscale-up.service
install -D --mode=644 \
  "$SDK/tailscale-auth.service" \
  /etc/systemd/system/tailscale-auth.service
sed -i "s|@SDK_SYSTEMD_SECRET_SOCKET@|${SDK_SYSTEMD_SECRET_SOCKET}|g" \
  /etc/systemd/system/tailscale-auth.service
systemctl daemon-reload
# Never start the daemon here: on a refresh, restore-state must merge
# the saved node state before the daemon first runs, or it would come
# up logged out and pull the authentication flow in early. Enabling it
# keeps container restarts resuming from the daemon's own state, and
# its Wants= starts the authentication flow exactly when the daemon
# reports it is not logged in, so the flow needs no enablement.
systemctl enable tailscaled.service
systemctl enable --now tailscale-up.path

cat >/etc/profile.d/tailscale-auth.sh <<EOF
# Workshop starts login shells through "bash -l -c", never interactive,
# so detect a terminal instead of an interactive shell.
if [ -t 1 ] && [ -r /run/user/1000/tailscale/authorization-url ]; then
  printf '\nTailscale authentication is required.\n'
  printf 'Open this URL in your browser:\n  '
  cat /run/user/1000/tailscale/authorization-url
  printf '\n'
fi
export PATH="${SDK}/bin:\$PATH"
EOF
