#!/bin/bash

set -euo pipefail

# Credential retrieval needs the system manager's access to the secret socket.
# Remove the old user unit when refreshing an existing workshop.
legacy_unit="$HOME/.config/systemd/user/tailscale-auth.service"
if [ -f "$legacy_unit" ]; then
  systemctl --user disable --now tailscale-auth.service
  rm -f "$legacy_unit"
  systemctl --user daemon-reload
fi
