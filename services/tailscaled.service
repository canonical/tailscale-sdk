[Unit]
Description=Tailscale daemon
After=network.target
# Pull the authentication service in whenever the daemon starts: its
# ExecCondition asks the daemon whether login is needed, so the flow
# runs exactly when it should, including after container restarts.
Wants=tailscale-auth.service
StartLimitIntervalSec=0

[Service]
Type=simple
StateDirectory=tailscale
RuntimeDirectory=tailscale
ExecStart=/var/lib/workshop/sdk/tailscale/bin/tailscaled \
    --state=/var/lib/tailscale/tailscaled.state \
    --statedir=/var/lib/tailscale \
    --socket=/run/tailscale/tailscaled.sock \
    --tun=tailscale0
ExecStop=/var/lib/workshop/sdk/tailscale/tailscale-stop
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target